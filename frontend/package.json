    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
