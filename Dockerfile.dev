# syntax=docker/dockerfile:1
# Development image: keeps Maven + source so `docker compose up` gives fast iteration via
# spring-boot:run instead of rebuilding a jar on every change. Not used in production.
FROM maven:3.9.9-eclipse-temurin-21
WORKDIR /workspace

COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -B -q dependency:go-offline

COPY src ./src

EXPOSE 8080
CMD ["mvn", "-B", "spring-boot:run"]
