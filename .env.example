# Copy to .env and adjust as needed:  cp .env.example .env
# Used by docker-compose.yml. Never commit the real .env file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=ai_shift_planner
POSTGRES_USER=ai_shift_planner
POSTGRES_PASSWORD=change_me_local_dev_only

# --- Backend -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/ai_shift_planner
DATABASE_USERNAME=ai_shift_planner
DATABASE_PASSWORD=change_me_local_dev_only

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET=change_me_local_dev_only_change_me_local_dev_only
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14

APP_DEFAULT_TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO

# Set to true once to populate a realistic demo dataset (one Mainz restaurant, 3 departments,
# 34 staff, a planning period with staffing requirements, availability and comments).
# Demo logins, all with password "demo1234":
#   admin@demo.local     ORG_ADMIN
#   manager@demo.local   SHIFT_MANAGER + LOCATION_MANAGER
#   employee@demo.local  EMPLOYEE (linked to Anna Becker)
SEED_DEMO_DATA=false

# --- Local AI (Ollama) --------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# --- Backend Docker image (used by docker-compose build) ---------------------
BACKEND_IMAGE_TAG=local
