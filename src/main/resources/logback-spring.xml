<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs go to stdout only. In Kubernetes the platform collects stdout; writing log files
  inside a container means logs that vanish with the pod and a disk that fills up quietly.

  The correlation id (from CorrelationIdFilter's MDC entry) is on every line, so a support
  request quoting a trace id can be resolved without guessing which request it belonged to.

  Never add a pattern element that could render a token, password or Authorization header.
-->
<configuration>

    <springProperty scope="context" name="applicationName" source="spring.application.name"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %-5level [%X{correlationId:-no-correlation-id}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Structured JSON for production, where a log aggregator parses it. Enabled with the
      "json-logs" profile so local development keeps the readable format above.
    -->
    <springProfile name="json-logs">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.JsonEncoder"/>
        </appender>
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!json-logs">
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.aishiftplanner" level="${APP_LOG_LEVEL:-INFO}"/>
    <!-- Timefold logs its score progress at INFO; useful, but it drowns everything else. -->
    <logger name="ai.timefold.solver" level="WARN"/>

</configuration>
